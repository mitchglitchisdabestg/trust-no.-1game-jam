config_version=5

[application]

config/name="Trust No.1 (Brackeys Jam 26-2)"
run/main_scene="uid://bheumvpgw1mxt"
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/image="uid://bd4l2gqd8h021"
config/icon="uid://crn8epp4rhxyw"

[autoload]

SignalBus="*uid://m72cy8qhe4fj"
Status="*uid://bq3kppt1f306g"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_with_u/plugin.cfg")

[file_customization]

folder_colors={
"res://Addons/": "yellow",
"res://Assets/": "purple",
"res://Scenes/": "blue",
"res://Scripts/": "green"
}

[filesystem]

